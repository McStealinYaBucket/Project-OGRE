     @cache
+    def end_of(addr: int) -> tuple[int, str] | None:
+        """OGRE: if addr is one past the end of a matched variable, return that variable's
+        start address and an `<name>+end` name, unless an entity other than an unmatched
+        string starts there (PLAYER 0x00bdb080 starts a garbage "string" made of a COL pointer).
+        ParseAsm uses it only when the same function also references the start (a begin/end
+        pair, as in boost's prime_list lower_bound)."""
+        here = db.get(image_id, addr, exact=True)
+        if here is not None and (here.entity_type != EntityType.STRING or here.matched):
+            return None
+        prev = db.get(image_id, addr - 1, exact=False)
+        if prev is None or not prev.matched or prev.entity_type != EntityType.DATA:
+            return None
+        start = prev.addr(image_id)
+        size = prev.any_size(image_id)
+        if start is None or size < 8 or start + size != addr:
+            return None
+        name = prev.match_name("+end")
+        return None if name is None else (start, name)
