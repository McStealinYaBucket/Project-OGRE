+				pluginList[i]->OnNewConnection(packet->systemAddress, packet->guid, true);
+				break;
+			case ID_CONNECTION_REQUEST_ACCEPTED:
+				pluginList[i]->OnNewConnection(packet->systemAddress, packet->guid, false);
