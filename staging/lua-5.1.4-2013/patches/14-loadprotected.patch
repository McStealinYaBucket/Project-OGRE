+/* ROBLOX: load a script held in a ProtectedString. A source whose hash no
+** longer matches compiles as an empty chunk; otherwise the chunk is streamed
+** one character at a time through an MD5 of salt+source, and a mismatch found
+** at the end injects " ]]\r\n%" so the chunk fails to compile. */
+typedef struct ProtectedLoad {
+  int index;
+  const RBX::ProtectedString *ps;
+  char ch;
+  boost::scoped_ptr<RBX::MD5Hasher> hasher;
+  bool checked;
+} ProtectedLoad;
+
+
+static const char *protReader (lua_State *L, void *ud, size_t *size) {
+  ProtectedLoad *pl = (ProtectedLoad *)ud;
+  (void)L;
+  if (pl->index > 0)
+    pl->hasher->addData(&pl->ch, 1);  /* the character returned last time */
+  if (!pl->ps->readUnprotectedChar(pl->index, &pl->ch)) {
+    if (pl->index > 1 && !pl->checked) {  /* end of source: check the hash once */
+      std::string hash = pl->hasher->toString();
+      std::string original = pl->ps->getOriginalHash();
+      if (original != hash) {
+        const char *msg = " ]]\r\n%";
+        RBX::DataModel::sendStats |= HATE_LUA_HASH_CHANGED;
+        pl->checked = true;
+        *size = strlen(msg);
+        return msg;
+      }
+    }
+    *size = 0;
+    return NULL;
+  }
+  pl->index++;
+  *size = 1;
+  return &pl->ch;
+}
+
+
+LUALIB_API int luaL_loadprotected (lua_State *L, const RBX::ProtectedString& ps,
+                                   const char *name) {
+  std::string computed;
+  ps.calculateHash(&computed);
+  if (ps.getOriginalHash() != computed) {
+    LoadS ls;
+    RBX::DataModel::sendStats |= HATE_LUA_SCRIPT_HASH_CHANGED;
+    ls.s = "";
+    ls.size = 0;
+    return lua_load(L, getS, &ls, name);
+  }
+  else {
+    ProtectedLoad pl;
+    pl.index = 0;
+    pl.checked = false;
+    pl.ps = &ps;
+    pl.hasher.reset(RBX::MD5Hasher::create());
+    pl.hasher->addData(ps.getSalt());
+    return lua_load(L, protReader, &pl, name);
+  }
+}
+
+
 
 /* }====================================================== */
 
