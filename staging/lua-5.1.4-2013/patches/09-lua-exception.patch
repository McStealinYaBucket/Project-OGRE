+/* ROBLOX: throw a lua_exception (ldo.c); a std::exception thrown by C++ code
+** called from Lua is turned into a Lua error */
+#include <exception>
+#define LUAI_THROW(L,c)	throw(lua_exception(L,c))
+#define LUAI_TRY(L,c,a)	try { a } \
+	catch (lua_exception& e) { e.commit(); if ((c)->status == 0) (c)->status = -1; } \
+	catch (std::exception const& e) { \
+		try { luaG_runerror(L, "%s", e.what()); } \
